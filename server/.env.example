# Copy to .env for local runs. On Fly.io, set these with `fly secrets set`.

# Long random string shared with the iPhone app. Generate: openssl rand -hex 32
APP_SECRET=

# Haley's own Dexcom account (the one the Dexcom G6 app is signed in to), with Share turned on.
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
# us, ous (outside the US) or jp
DEXCOM_REGION=us

PATIENT_NAME=Haley

# Apple Push Notifications: Apple Developer > Certificates, IDs & Profiles > Keys > new key with APNs.
APNS_KEY_ID=
APNS_TEAM_ID=
# Must match the app's bundle identifier in ios/project.yml
APNS_BUNDLE_ID=com.example.haleyspancreas
# Either paste the .p8 contents (newlines as \n) or point to the file.
APNS_PRIVATE_KEY=
# APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# How often to check Share while a reading is due (seconds, minimum 5).
POLL_INTERVAL_SECONDS=10
PORT=8080
DATA_DIR=./data
